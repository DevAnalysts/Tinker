{% doc %}
  Renders the White Hills Knives multi-theme switcher (Quick Sun/Moon toggle + 4-theme picker).
  @example
  {% render 'knife-theme-switcher' %}
{% enddoc %}

<div class="knife-theme-dropdown">
  <div style="display:flex; align-items:center; gap:0.375rem;">
    <!-- 1-Click Quick Toggle: Sun / Moon -->
    <button
      type="button"
      data-knife-toggle-light-dark
      class="knife-icon-btn"
      title="Toggle Light / Dark Mode"
      aria-label="Toggle Light / Dark Mode"
    >
      <svg class="knife-sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
      </svg>
    </button>

    <!-- Granular Atelier Theme Dropdown Pill -->
    <button
      type="button"
      data-knife-theme-dropdown-trigger
      class="knife-theme-pill"
      aria-label="Change atelier theme"
    >
      <span class="knife-theme-dot" data-knife-current-theme-dot style="background-color: #e67e22;"></span>
      <span class="font-sans" data-knife-current-theme-name style="letter-spacing:0.1em; text-transform:uppercase; font-size:0.6875rem; font-weight:600;">
        Obsidian
      </span>
    </button>
  </div>

  <!-- Theme Dropdown Menu -->
  <div class="knife-theme-menu" data-knife-theme-dropdown-menu>
    <div style="border-bottom:1px solid var(--border); padding:0.5rem 0.75rem; display:flex; justify-content:space-between; align-items:center;">
      <div>
        <p class="eyebrow" style="color:var(--primary); font-size:0.575rem; margin:0;">Atelier Aesthetics</p>
        <p style="font-size:0.6875rem; color:var(--muted-foreground); margin:0.125rem 0 0 0;">Select your viewing mood</p>
      </div>
      <button type="button" data-knife-toggle-light-dark style="background:none; border:none; color:var(--primary); font-size:0.6875rem; font-weight:600; cursor:pointer;">
        Toggle
      </button>
    </div>

    <div style="margin-top:0.25rem;">
      <button type="button" class="knife-theme-opt is-active" data-theme-choice="obsidian">
        <span class="knife-theme-dot" style="background-color:#e67e22; width:1.25rem; height:1.25rem;"></span>
        <div style="flex:1; min-width:0;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong style="font-size:0.75rem;">Obsidian Forge</strong>
            <span style="font-size:0.55rem; color:var(--muted-foreground); text-transform:uppercase;">Dark Atelier</span>
          </div>
          <p style="font-size:0.65rem; color:var(--muted-foreground); margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
            Midnight forge & glowing ember copper
          </p>
        </div>
      </button>

      <button type="button" class="knife-theme-opt" data-theme-choice="light">
        <span class="knife-theme-dot" style="background-color:#93532b; width:1.25rem; height:1.25rem;"></span>
        <div style="flex:1; min-width:0;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong style="font-size:0.75rem;">Daylight Atelier</strong>
            <span style="font-size:0.55rem; color:#92400e; background:#fef3c7; padding:0.1rem 0.3rem; border-radius:0.25rem; text-transform:uppercase;">Light Theme</span>
          </div>
          <p style="font-size:0.65rem; color:var(--muted-foreground); margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
            Sunlit alabaster ivory & saddle leather
          </p>
        </div>
      </button>

      <button type="button" class="knife-theme-opt" data-theme-choice="silver">
        <span class="knife-theme-dot" style="background-color:#cbd5e1; width:1.25rem; height:1.25rem;"></span>
        <div style="flex:1; min-width:0;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong style="font-size:0.75rem;">Silver Damascus</strong>
            <span style="font-size:0.55rem; color:var(--muted-foreground); text-transform:uppercase;">Steel Dark</span>
          </div>
          <p style="font-size:0.65rem; color:var(--muted-foreground); margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
            Cold liquid steel & polished chromium
          </p>
        </div>
      </button>

      <button type="button" class="knife-theme-opt" data-theme-choice="imperial">
        <span class="knife-theme-dot" style="background-color:#d4af37; width:1.25rem; height:1.25rem;"></span>
        <div style="flex:1; min-width:0;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong style="font-size:0.75rem;">Imperial Damascus</strong>
            <span style="font-size:0.55rem; color:var(--muted-foreground); text-transform:uppercase;">Royal Dark</span>
          </div>
          <p style="font-size:0.65rem; color:var(--muted-foreground); margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
            Deep royal oxblood & 24k burnished gold
          </p>
        </div>
      </button>
    </div>
  </div>
</div>

