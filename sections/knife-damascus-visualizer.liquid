{% comment %}
  Section: Knife Damascus Visualizer
  Interactive metallurgy pattern explorer showcasing folded steels, acid etching, and Rockwell hardness.
{% endcomment %}

<section id="metallurgy-section" class="knife-container" style="padding-top:6rem; padding-bottom:6rem;">
  <div class="knife-section-heading reveal">
    <p class="eyebrow" style="color:var(--primary);">{{ section.settings.eyebrow | default: 'The Metallurgy' }}</p>
    <h2>{{ section.settings.title | default: 'Patterns Forged in Fire & Acid' }}</h2>
    <p>{{ section.settings.copy | default: 'The mesmerizing water wave patterns on our blades are not laser-printed or coated. They are the physical topography of two dissimilar steels folded, beaten, and etched by hand.' }}</p>
  </div>

  <!-- Interactive Pattern Selector Tabs -->
  <div class="knife-metallurgy-tabs reveal">
    <button type="button" class="knife-tab-pill is-active" data-knife-metallurgy-tab="raindrop">Raindrop Pattern</button>
    <button type="button" class="knife-tab-pill" data-knife-metallurgy-tab="twist">Twist (Torsion) Billet</button>
    <button type="button" class="knife-tab-pill" data-knife-metallurgy-tab="ladder">Ladder Damascus</button>
    <button type="button" class="knife-tab-pill" data-knife-metallurgy-tab="vg10">73-Layer Japanese VG-10</button>
  </div>

  <!-- Interactive Detail Card -->
  <div class="knife-metallurgy-card reveal">
    <div class="knife-metallurgy-grid">
      <!-- Left Column: Story & Distinguishing Attributes -->
      <div style="display:flex; flex-direction:column; gap:1.5rem;">
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <span id="knife-metal-layers" class="eyebrow" style="background:rgba(var(--primary-rgb),0.15); color:var(--primary); padding:0.25rem 0.75rem; border-radius:9999px;">
            320+ Folded Layers
          </span>
          <span class="eyebrow" style="color:var(--muted-foreground);">Certified Forge Heat-Treated</span>
        </div>

        <h3 id="knife-metal-title" class="font-display" style="font-size:2rem; font-weight:500; margin:0; color:var(--foreground);">
          Raindrop Pattern
        </h3>

        <p id="knife-metal-desc" style="font-size:1rem; font-weight:300; line-height:1.7; color:var(--muted-foreground); margin:0;">
          Created by pressing spherical dimples into the glowing billet before the final surface grind. As the peaks are flattened, concentric water-ripple circles are revealed across the blade.
        </p>

        <div style="margin-top:0.5rem;">
          <p class="eyebrow" style="color:var(--foreground); font-size:0.6875rem; margin-bottom:0.75rem;">Distinguishing Attributes</p>
          <ul id="knife-metal-specs-list" style="list-style:none; padding:0; margin:0;">
            <li style="display:flex; align-items:flex-start; gap:0.625rem; font-size:0.75rem; color:var(--muted-foreground); margin-bottom:0.5rem;">
              <span style="color:var(--primary);">&#10022;</span>
              <span>Concentric circular droplet eddies</span>
            </li>
            <li style="display:flex; align-items:flex-start; gap:0.625rem; font-size:0.75rem; color:var(--muted-foreground); margin-bottom:0.5rem;">
              <span style="color:var(--primary);">&#10022;</span>
              <span>Superior edge retention from 15N20 contrast</span>
            </li>
            <li style="display:flex; align-items:flex-start; gap:0.625rem; font-size:0.75rem; color:var(--muted-foreground); margin-bottom:0.5rem;">
              <span style="color:var(--primary);">&#10022;</span>
              <span>Ideal for folding pocket and EDC blades</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Forge Recipe Box -->
      <div class="knife-spec-box">
        <h4 class="font-display" style="font-size:1.125rem; font-weight:500; color:var(--foreground); margin:0; padding-bottom:0.75rem; border-bottom:1px solid var(--border);">
          Forge Recipe & Specs
        </h4>

        <div>
          <span style="font-size:0.65rem; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted-foreground); display:block;">Primary Steels</span>
          <span id="knife-metal-steel" style="font-size:0.8125rem; font-weight:500; color:var(--foreground); margin-top:0.25rem; display:block;">
            1095 High-Carbon & 15N20 Nickel Alloy
          </span>
        </div>

        <div>
          <span style="font-size:0.65rem; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted-foreground); display:block;">Etching Process</span>
          <span id="knife-metal-etching" style="font-size:0.8125rem; font-weight:500; color:var(--foreground); margin-top:0.25rem; display:block;">
            Deep Ferric Chloride Acid Bath
          </span>
        </div>

        <div>
          <span style="font-size:0.65rem; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted-foreground); display:block;">Rockwell Hardness Range</span>
          <span id="knife-metal-hrc" style="font-size:0.8125rem; font-weight:600; color:var(--primary); margin-top:0.25rem; display:block;">
            58–60 HRC Vacuum Heat-Treated
          </span>
        </div>

        <div style="border-top:1px solid var(--border); padding-top:0.75rem; display:flex; align-items:center; gap:0.5rem; font-size:0.75rem; color:var(--muted-foreground);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary); flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Certified White Hills California Atelier Guarantee</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Knife Damascus Metallurgy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The Metallurgy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Patterns Forged in Fire & Acid"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Section Copy",
      "default": "The mesmerizing water wave patterns on our blades are not laser-printed or coated. They are the physical topography of two dissimilar steels folded, beaten, and etched by hand."
    }
  ],
  "presets": [
    {
      "name": "Knife Damascus Metallurgy"
    }
  ]
}
{% endschema %}

