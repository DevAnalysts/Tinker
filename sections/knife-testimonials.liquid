{% comment %}
  Section: Knife Testimonials
  1,700+ Verified 5-Star Reviews from collectors, culinary chefs, and outdoor field guides.
{% endcomment %}

<section class="knife-container" style="padding-top:6rem; padding-bottom:6rem;">
  <div class="knife-section-heading reveal">
    <p class="eyebrow" style="color:var(--primary);">{{ section.settings.eyebrow | default: 'From the Collectors' }}</p>
    <h2>{{ section.settings.title | default: '1,700+ Verified 5-Star Reviews' }}</h2>
    <p>{{ section.settings.copy | default: 'Collectors, culinary chefs, and outdoor field guides share their bench experiences.' }}</p>
  </div>

  <div class="knife-testimonials-grid">
    <!-- Testimonial 1 -->
    <figure class="knife-testimonial-card reveal">
      <div>
        <div style="display:flex; justify-content:center; gap:0.25rem; color:var(--primary);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <blockquote style="margin:1.5rem 0 0 0; font-size:0.875rem; font-weight:300; line-height:1.7; color:var(--muted-foreground); font-style:italic;">
          &ldquo;The blade came sharper than anything in my collection, and the stag handle fits the hand like it was carved for me. The raindrop Damascus pattern under natural light is breathtaking.&rdquo;
        </blockquote>
      </div>
      <figcaption style="margin-top:2rem; padding-top:1rem; border-top:1px solid var(--border);">
        <p class="font-display" style="font-size:0.875rem; font-weight:600; color:var(--foreground); margin:0;">Marcus T.</p>
        <p class="eyebrow" style="color:var(--primary); font-size:0.55rem; margin:0.25rem 0 0.125rem 0;">Verified Collector — Montana</p>
        <p style="font-size:0.6875rem; color:var(--muted-foreground); margin:0;">Handmade Damascus Pocket Knife WH 3542</p>
      </figcaption>
    </figure>

    <!-- Testimonial 2 -->
    <figure class="knife-testimonial-card reveal" style="transition-delay: 80ms;">
      <div>
        <div style="display:flex; justify-content:center; gap:0.25rem; color:var(--primary);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <blockquote style="margin:1.5rem 0 0 0; font-size:0.875rem; font-weight:300; line-height:1.7; color:var(--muted-foreground); font-style:italic;">
          &ldquo;I own three VG-10 knives from high-end Japanese cutlery houses. The Sato out-cuts all of them, holds its edge through 40-pound prep shifts, and costs half the price.&rdquo;
        </blockquote>
      </div>
      <figcaption style="margin-top:2rem; padding-top:1rem; border-top:1px solid var(--border);">
        <p class="font-display" style="font-size:0.875rem; font-weight:600; color:var(--foreground); margin:0;">Elena R.</p>
        <p class="eyebrow" style="color:var(--primary); font-size:0.55rem; margin:0.25rem 0 0.125rem 0;">Executive Chef — Portland, OR</p>
        <p style="font-size:0.6875rem; color:var(--muted-foreground); margin:0;">Sato VG10 Copper Damascus Chef Knife</p>
      </figcaption>
    </figure>

    <!-- Testimonial 3 -->
    <figure class="knife-testimonial-card reveal" style="transition-delay: 160ms;">
      <div>
        <div style="display:flex; justify-content:center; gap:0.25rem; color:var(--primary);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <blockquote style="margin:1.5rem 0 0 0; font-size:0.875rem; font-weight:300; line-height:1.7; color:var(--muted-foreground); font-style:italic;">
          &ldquo;Ordered the Viking axe for my brother's wedding. Arrived from California in four days, and the hand-braided leather wrap and axe weight balance are museum quality.&rdquo;
        </blockquote>
      </div>
      <figcaption style="margin-top:2rem; padding-top:1rem; border-top:1px solid var(--border);">
        <p class="font-display" style="font-size:0.875rem; font-weight:600; color:var(--foreground); margin:0;">David K.</p>
        <p class="eyebrow" style="color:var(--primary); font-size:0.55rem; margin:0.25rem 0 0.125rem 0;">Verified Buyer — Texas</p>
        <p style="font-size:0.6875rem; color:var(--muted-foreground); margin:0;">Handmade Forged Steel Viking Axe</p>
      </figcaption>
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Knife Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "From the Collectors"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "1,700+ Verified 5-Star Reviews"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Section Copy",
      "default": "Collectors, culinary chefs, and outdoor field guides share their bench experiences."
    }
  ],
  "presets": [
    {
      "name": "Knife Testimonials"
    }
  ]
}
{% endschema %}

