{% doc %}
  Renders the White Hills Knives slide-over cart drawer (Atelier Ledger).
  Features live free shipping progress bar, line items with quantity & remove, and checkout CTA.
  @example
  {% render 'knife-cart-drawer' %}
{% enddoc %}

<div id="knife-cart-drawer-overlay" class="knife-cart-drawer-overlay">
  <aside aria-label="Atelier Cart Ledger" class="knife-cart-drawer">
    <!-- Header -->
    <div class="knife-cart-drawer-header">
      <div>
        <h2 class="font-display" style="font-size:1.25rem; font-weight:500; margin:0; color:var(--foreground); letter-spacing:0.05em;">
          Atelier Ledger
        </h2>
        <p id="knife-cart-piece-count" class="eyebrow" style="color:var(--primary); font-size:0.575rem; margin:0.25rem 0 0 0;">
          0 Pieces Selected
        </p>
      </div>
      <button
        type="button"
        data-knife-close-cart
        class="knife-icon-btn"
        style="width:2rem; height:2rem; border:none;"
        aria-label="Close cart"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Free California Shipping Meter -->
    <div class="knife-free-shipping-bar">
      <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.75rem;">
        <span id="knife-cart-progress-text" style="display:flex; align-items:center; gap:0.375rem; color:var(--foreground); font-weight:500;">
          Add for free shipping
        </span>
        <span id="knife-cart-progress-percent" style="font-size:0.6875rem; color:var(--muted-foreground);">0%</span>
      </div>
      <div class="knife-progress-track">
        <div id="knife-cart-progress-fill" class="knife-progress-fill" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Items Scroll Container -->
    <div id="knife-cart-items-container" class="knife-cart-items-scroll">
      <!-- Injected dynamically by knife-atelier.js -->
    </div>

    <!-- Empty State -->
    <div id="knife-cart-empty-state" style="display:none; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:4rem 1.5rem; flex:1;">
      <div style="width:4rem; height:4rem; border-radius:9999px; background:rgba(var(--primary-rgb),0.1); color:var(--primary); display:flex; align-items:center; justify-content:center; margin-bottom:1rem;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </div>
      <h3 class="font-display" style="font-size:1.25rem; font-weight:500; color:var(--foreground); margin:0 0 0.5rem 0;">Your Ledger is Empty</h3>
      <p style="font-size:0.8125rem; color:var(--muted-foreground); margin:0 0 1.5rem 0; max-width:18rem; line-height:1.6;">
        Explore our hand-forged Damascus folding pocket knives, hunting blades, and chef collections.
      </p>
      <button
        type="button"
        data-knife-close-cart
        class="knife-btn-primary"
        style="padding:0.75rem 1.5rem;"
      >
        Explore Catalog
      </button>
    </div>

    <!-- Footer Summary & Checkout -->
    <div id="knife-cart-footer-container" class="knife-cart-footer" style="display:none;">
      <div style="display:flex; flex-direction:column; gap:0.5rem; font-size:0.8125rem;">
        <div style="display:flex; justify-content:space-between; color:var(--muted-foreground);">
          <span>Subtotal</span>
          <span id="knife-cart-subtotal" style="font-weight:600; color:var(--foreground);">$0.00</span>
        </div>
        <div style="display:flex; justify-content:space-between; color:var(--muted-foreground);">
          <span>Dispatched From</span>
          <span style="color:var(--foreground);">California, USA</span>
        </div>
        <div style="display:flex; justify-content:space-between; color:var(--muted-foreground);">
          <span>Estimated Shipping</span>
          <span style="color:var(--primary); font-weight:500;">Calculated at Checkout</span>
        </div>
        <div style="display:flex; justify-content:space-between; border-top:1px solid var(--border); padding-top:0.75rem; font-size:1rem; font-weight:600;">
          <span class="font-display">Total</span>
          <span id="knife-cart-total" class="font-display" style="color:var(--primary); font-size:1.25rem;">$0.00</span>
        </div>
      </div>

      <a
        href="/checkout"
        class="knife-btn-primary"
        style="width:100%; justify-content:center; margin-top:1.25rem; padding:0.875rem 1rem; text-decoration:none;"
      >
        Proceed to Secure Checkout &rarr;
      </a>

      <div style="display:flex; justify-content:center; gap:1.25rem; margin-top:1rem; font-size:0.6875rem; color:var(--muted-foreground);">
        <span>&#10003; 30-Day Guarantee</span>
        <span>&#10003; Insured California Transit</span>
      </div>
    </div>
  </aside>
</div>

