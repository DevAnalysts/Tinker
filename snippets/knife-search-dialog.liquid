{% doc %}
  Renders the White Hills Knives predictive search dialog modal.
  @example
  {% render 'knife-search-dialog' %}
{% enddoc %}

<div id="knife-search-dialog-overlay" class="knife-search-dialog-overlay">
  <div class="knife-search-dialog">
    <div class="knife-search-header">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--muted-foreground);"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        id="knife-search-input"
        type="text"
        placeholder="Search Damascus folding pocket knives, hunting knives, VG-10 chef knives..."
        autocomplete="off"
      />
      <button
        type="button"
        data-knife-close-search
        style="background:none; border:none; color:var(--muted-foreground); font-size:0.75rem; font-weight:600; padding:0.25rem 0.5rem; border-radius:0.25rem; cursor:pointer;"
      >
        ESC
      </button>
    </div>

    <div id="knife-search-results-list" class="knife-search-results">
      <p class="eyebrow" style="color:var(--muted-foreground); padding:0.5rem 0;">Trending Damascus Blades</p>
      {% for product in collections['all'].products limit: 4 %}
        <div
          class="knife-search-result-row"
          data-handle="{{ product.handle }}"
          data-title="{{ product.title | escape }}"
          data-price="{{ product.price | money_without_currency }}"
          data-image="{{ product.featured_image | image_url: width: 300 }}"
          style="display:flex; align-items:center; gap:1rem; padding:0.75rem; border-radius:0.5rem; cursor:pointer;"
        >
          <img src="{{ product.featured_image | image_url: width: 100, height: 100, crop: 'center' }}" alt="{{ product.title | escape }}" style="width:3.5rem; height:3.5rem; object-fit:cover; border-radius:0.375rem; border:1px solid var(--border);" />
          <div style="flex:1; min-width:0;">
            <h4 style="font-size:0.875rem; font-weight:500; margin:0; color:var(--foreground); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
              {{ product.title | split: ' - ' | first }}
            </h4>
            <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.25rem;">
              <span style="font-family:var(--font-display); font-size:0.75rem; color:var(--primary); font-weight:600;">{{ product.price | money }}</span>
              <span style="font-size:0.65rem; color:var(--muted-foreground);">· 100% Hand-Forged</span>
            </div>
          </div>
          <span style="color:var(--muted-foreground); font-size:1.125rem;">&rarr;</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

